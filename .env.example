# M4 — RAG Environment Variables

# ============================================================
# Provider Selection
# ============================================================
# Which provider to use for embeddings and LLM responses
# Options: 'openai' or 'gemini'
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# ============================================================
# OpenAI (used when provider=openai)
# ============================================================
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model for converting text to vectors
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM model for generating answers
OPENAI_LLM_MODEL=gpt-4o-mini

# ============================================================
# Gemini (used when provider=gemini)
# ============================================================
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model for converting text to vectors
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM model for generating answers
GEMINI_LLM_MODEL=gemini-3.6-flash

# ============================================================
# Vector Store Configuration
# ============================================================
# Options: 'memory' (local development, default) | 'chroma' | 'turso' (production)
VECTOR_STORE_TYPE=memory

# ChromaDB URL (only needed if VECTOR_STORE_TYPE=chroma)
# CHROMA_URL=http://localhost:8000

# M9 — Turso Cloud (only needed if VECTOR_STORE_TYPE=turso)
# SECRET: TURSO_AUTH_TOKEN is a live database credential. Never commit it,
# never log it, never expose it to the browser. Set both in Vercel project
# settings (Settings -> Environment Variables).
# Create the database in Turso Cloud: https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# Chunk table name (default: hanif_academy_chunks; the vec0 vector table is
# <table>_vec).
# TURSO_TABLE=hanif_academy_chunks

# Embedding dimensions. Leave unset to derive from the embedding provider
# (Gemini gemini-embedding-001 = 768, OpenAI text-embedding-3-small = 1536).
# For OpenAI embeddings use:
# VECTOR_DIMENSIONS=1536

# ============================================================
# PRODUCTION — Turso + OpenAI embeddings (Vercel)
# ============================================================
# Copy this block to your Vercel project environment (Settings -> Environment
# Variables) — NEVER to a tracked file. TURSO_AUTH_TOKEN and OPENAI_API_KEY
# are secrets.
#
#   EMBEDDING_PROVIDER=openai
#   LLM_PROVIDER=openai
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#   OPENAI_API_KEY=your_openai_api_key_here
#   VECTOR_STORE_TYPE=turso
#   TURSO_DATABASE_URL=libsql://your-db-org.turso.io
#   TURSO_AUTH_TOKEN=your_turso_auth_token
#   TURSO_TABLE=hanif_academy_chunks
#   VECTOR_DIMENSIONS=1536
#
# The Turso database must have native vector support (vector32/vector_distance_cos).
# The vec0 extension is NOT used. Run the schema migration before ingesting:
#   EMBEDDING_PROVIDER=openai VECTOR_STORE_TYPE=turso npm run migrate:turso

# ============================================================
# RAG Settings
# ============================================================
# Chunk size in characters for splitting documents
RAG_CHUNK_SIZE=500

# Overlap between chunks in characters
RAG_CHUNK_OVERLAP=100

# Number of relevant chunks to retrieve
RAG_TOP_K=5

# Maximum tokens for context sent to LLM
RAG_MAX_CONTEXT_TOKENS=4000

# ============================================================
# M8 — Production (Vercel) Settings
# ============================================================
# On Vercel, set ALL of the variables above in the project's environment
# settings (Settings -> Environment Variables) — NEVER in a tracked file.
# The static site is served from the build/ output; /api/ask, /api/tutor and
# /api/ask/health are served by Vercel Functions in the api/ directory.

# Per-instance API rate limiting (see src/vercel/rate-limit.ts).
# The limiter is in-memory per serverless instance — conservative defaults;
# a hosted/distributed limiter can replace it later.
API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
