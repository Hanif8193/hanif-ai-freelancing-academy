# M4 — RAG Environment Variables

# ============================================================
# Provider Selection
# ============================================================
# Which provider to use for embeddings and LLM responses
# Options: 'openai' or 'gemini'
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# ============================================================
# OpenAI (used when provider=openai)
# ============================================================
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model for converting text to vectors
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM model for generating answers
OPENAI_LLM_MODEL=gpt-4o-mini

# ============================================================
# Gemini (used when provider=gemini)
# ============================================================
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model for converting text to vectors
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM model for generating answers
GEMINI_LLM_MODEL=gemini-2.5-flash

# ============================================================
# Vector Store Configuration
# ============================================================
# Options: 'memory' (development) or 'chroma' (production)
VECTOR_STORE_TYPE=memory

# ChromaDB URL (only needed if VECTOR_STORE_TYPE=chroma)
# CHROMA_URL=http://localhost:8000

# ============================================================
# RAG Settings
# ============================================================
# Chunk size in characters for splitting documents
RAG_CHUNK_SIZE=500

# Overlap between chunks in characters
RAG_CHUNK_OVERLAP=100

# Number of relevant chunks to retrieve
RAG_TOP_K=5

# Maximum tokens for context sent to LLM
RAG_MAX_CONTEXT_TOKENS=4000

# ============================================================
# M8 — Production (Vercel) Settings
# ============================================================
# On Vercel, set ALL of the variables above in the project's environment
# settings (Settings -> Environment Variables) — NEVER in a tracked file.
# The static site is served from the build/ output; /api/ask, /api/tutor and
# /api/ask/health are served by Vercel Functions in the api/ directory.

# Per-instance API rate limiting (see src/vercel/rate-limit.ts).
# The limiter is in-memory per serverless instance — conservative defaults;
# a hosted/distributed limiter can replace it later.
API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
